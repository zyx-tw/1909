# /opt/1909/.env on the host, or .env.local in development.
APP_1909_VERSION=latest
# Where the web port binds; put a reverse proxy with TLS in front.
APP_1909_BIND=127.0.0.1:3000

DATABASE_URL=            # pooled Neon URL
BETTER_AUTH_SECRET=      # openssl rand -base64 32
BETTER_AUTH_URL=https://1909.zyx.tw
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=    # redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google

# Traces and logs to Sensorium (OTLP/JSON). Leave the endpoint empty to send
# nothing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=1909
